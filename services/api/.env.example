# Copia questo file in ".env" (stessa cartella) e scrivi le tue chiavi vere.
# ".env" non viene mai caricato su GitHub (è nel .gitignore): resta solo sul
# tuo computer.

# Obbligatoria: legge le foto e propone gli outfit.
ANTHROPIC_API_KEY=

# Facoltative: usale solo se vuoi provare anche questi provider (es. dal
# Playground modelli). Senza chiave, quel provider resta segnato «senza
# chiave» e l'app funziona comunque su quello che hai configurato.
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Facoltativa: se manca, le foto restano con lo sfondo originale invece di
# essere scontornate — l'app funziona lo stesso.
FAL_KEY=

# Facoltative: spostano i due flussi veri (lettura foto, suggerimenti) su un
# provider diverso da Anthropic. Il modello si può lasciare vuoto: si prende
# il primo del catalogo di quel provider. Si rileggono solo riavviando
# "npm run api:local": vengono lette all'avvio, non a ogni richiesta.
#PROVIDER_VISIONE=google
#MODELLO_VISIONE=
#PROVIDER_STILISTA=openai
#MODELLO_STILISTA=

# Facoltative: senza queste due, i capi e le foto restano in memoria e si
# azzerano ad ogni riavvio di "npm run api:local" (comodo per provare, inutile
# per usare l'app davvero). Con entrambe impostate i capi sopravvivono al
# riavvio: prima "npm run db:up" (solo Postgres, in Docker), poi qui sotto.
#DATABASE_URL=host=localhost port=5432 dbname=wardrobe user=wardrobe password=wardrobe
# Cartella sul disco dove restano le foto — qualunque percorso va bene.
#CARTELLA_FOTO=./dati/foto

# Non serve impostarla: l'IP di questo computer sulla rete Wi-Fi (quello che
# un telefono userebbe per raggiungerlo) viene rilevato da solo. Solo se il
# rilevamento sbaglia — più schede di rete — la si scrive qui a mano.
#HOST_LOCALE=
