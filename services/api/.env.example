# Copia questo file in ".env" (stessa cartella) e scrivi le tue chiavi vere.
# ".env" non viene mai caricato su GitHub (è nel .gitignore): resta solo sul
# tuo computer.

# Obbligatoria: legge le foto e propone gli outfit.
ANTHROPIC_API_KEY=

# Obbligatoria, sempre — anche in locale: non esiste più un modo di accedere
# senza un JWT valido. Il backend firma e verifica con questa i propri token
# di login (POST /auth/accedi, POST /auth/registrati) e le URL firmate delle
# foto (GET/PUT /foto/{chiave}) — stesso segreto, due usi. Una stringa lunga
# e casuale, es. `openssl rand -hex 32`.
JWT_SECRET=

# Obbligatoria per registrare un account: una lista di email separate da
# virgole. Vuota o assente, la registrazione è chiusa a chiunque — di
# proposito, non un dimenticanza da correggere.
EMAIL_AMMESSE=

# Facoltativa: una lista di email (separate da virgole) che possono vedere le
# segnalazioni di tutti — non solo le proprie — e cambiarne lo stato da
# "Profilo → Le mie segnalazioni". Pensata per chi ha accesso al progetto
# Sentry e lavora le segnalazioni: senza, restano tutte ferme su "Ricevuta"
# per sempre. Vuota o assente, nessuno è amministratore — fail-closed, come
# EMAIL_AMMESSE.
EMAIL_AMMINISTRATORI=

# Facoltative: usale solo se vuoi provare anche questi provider (vedi
# PROVIDER_VISIONE/PROVIDER_STILISTA sotto). Senza chiave, quel provider
# resta segnato «senza chiave» e l'app funziona comunque su quello che hai
# configurato.
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Facoltativa: se manca, le foto restano con lo sfondo originale invece di
# essere scontornate — l'app funziona lo stesso.
FAL_KEY=

# Facoltative: spostano i due flussi veri (lettura foto, suggerimenti) su un
# provider diverso da Anthropic. Il modello si può lasciare vuoto: si prende
# il primo del catalogo di quel provider. Si rileggono solo riavviando
# "npm run api:local": vengono lette all'avvio, non a ogni richiesta.
#PROVIDER_VISIONE=google
#MODELLO_VISIONE=
#PROVIDER_STILISTA=openai
#MODELLO_STILISTA=

# Facoltative: senza queste due, i capi e le foto restano in memoria e si
# azzerano ad ogni riavvio di "npm run api:local" (comodo per provare, inutile
# per usare l'app davvero). Con entrambe impostate i capi sopravvivono al
# riavvio: prima "npm run db:up" (solo Postgres, in Docker), poi qui sotto.
#DATABASE_URL=host=localhost port=5432 dbname=wardrobe user=wardrobe password=wardrobe
# Cartella sul disco dove restano le foto — qualunque percorso va bene.
#CARTELLA_FOTO=./dati/foto

# Non serve impostarla: l'IP di questo computer sulla rete Wi-Fi (quello che
# un telefono userebbe per raggiungerlo) viene rilevato da solo. Solo se il
# rilevamento sbaglia — più schede di rete — la si scrive qui a mano.
#HOST_LOCALE=

# Solo su un server pubblico (es. un VPS dietro un reverse proxy HTTPS): gli
# URL delle foto vengono costruiti a partire da qui invece che dall'IP LAN
# indovinato. Niente porta, niente slash finale — es. https://api.tuodominio.it
#BASE_URL_PUBBLICA=
