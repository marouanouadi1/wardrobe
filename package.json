{
  "name": "wardrobe",
  "private": true,
  "description": "Wardrobe — armadio digitale: app Expo, API Python su un VPS",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:app": "bash scripts/dev.sh --app",
    "mobile": "npm --prefix apps/mobile run start",
    "mobile:android": "npm --prefix apps/mobile run android",
    "mobile:ios": "npm --prefix apps/mobile run ios",
    "mobile:test": "npm --prefix apps/mobile run test",
    "contracts:generate": "node apps/mobile/contracts/scripts/generate.mjs",
    "contracts:check": "node apps/mobile/contracts/scripts/generate.mjs --verifica",
    "api:sync": "cd services/api && uv sync",
    "api:test": "cd services/api && uv run pytest",
    "api:cov": "cd services/api && uv run pytest --cov=src --cov-report=term-missing",
    "api:lint": "cd services/api && uv run ruff check . && uv run ruff format --check . && uv run mypy src",
    "api:local": "cd services/api && uv run python -m handlers.local_server",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:test": "supabase test db",
    "supabase:tipi": "bash scripts/tipi-database.sh",
    "supabase:verifica": "cd services/api && uv run python scripts/verifica_database.py",
    "typecheck": "npm --prefix apps/mobile run typecheck",
    "lint": "npm --prefix apps/mobile run lint"
  }
}
