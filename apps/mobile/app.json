{
  "expo": {
    "name": "Wardrobe",
    "slug": "wardrobe",
    "scheme": "wardrobe",
    "version": "0.6.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wardrobe.armadio",
      "infoPlist": {
        "NSCameraUsageDescription": "Serve per fotografare i tuoi capi e aggiungerli all'armadio.",
        "NSPhotoLibraryUsageDescription": "Serve per scegliere dalla galleria le foto dei tuoi capi."
      }
    },
    "android": {
      "package": "com.wardrobe.armadio",
      "adaptiveIcon": {
        "backgroundColor": "#15151A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "marouanouadi",
    "extra": {
      "eas": {
        "projectId": "1063da5e-dac1-4161-91a6-5e722a8fdc00"
      }
    }
  }
}
