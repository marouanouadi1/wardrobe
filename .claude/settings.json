{
  "permissions": {
    "deny": [
      "Read(./services/api/.env)",
      "Read(./apps/mobile/.env.local)",
      "Read(./.env)",
      "Read(./services/api/dati/foto/**)",
      "Edit(packages/contracts/src/generated/**)",
      "Write(packages/contracts/src/generated/**)",
      "Edit(packages/contracts/schema/**)",
      "Write(packages/contracts/schema/**)",
      "Edit(apps/web/**)",
      "Write(apps/web/**)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(ssh marouan@89.167.15.22:*)",
      "Bash(rsync:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/versioni-non-a-mano.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/migrazione-idempotente.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/lint-immediato.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/contratti-allineati.py",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
