    },
    "Profilo": {
      "$ref": "#/$defs/Profilo"
    },
    "Registrazione": {
      "$ref": "#/$defs/Registrazione"
    },
    "RichiestaAnalisi": {
      "$ref": "#/$defs/RichiestaAnalisi"
    },
    "RichiestaMessaggioChat": {
      "$ref": "#/$defs/RichiestaMessaggioChat"
    },
    "RichiestaSuggerimenti": {
      "$ref": "#/$defs/RichiestaSuggerimenti"
    },
    "RichiestaUpload": {
      "$ref": "#/$defs/RichiestaUpload"
    },
    "RiepilogoArmadio": {
      "$ref": "#/$defs/RiepilogoArmadio"
    },
    "RispostaChat": {
      "$ref": "#/$defs/RispostaChat"
    },
    "RispostaSuggerimenti": {
      "$ref": "#/$defs/RispostaSuggerimenti"
    },
    "RuoloChat": {
      "$ref": "#/$defs/RuoloChat"
    },
    "Segnalazione": {
      "$ref": "#/$defs/Segnalazione"
    },
    "SlotAvatar": {
      "$ref": "#/$defs/SlotAvatar"
    },
    "Stagione": {
      "$ref": "#/$defs/Stagione"
    },
    "StatoAnalisi": {
      "$ref": "#/$defs/StatoAnalisi"
    },
    "StatoCapo": {
      "$ref": "#/$defs/StatoCapo"
    },
    "StatoSegnalazione": {
      "$ref": "#/$defs/StatoSegnalazione"
