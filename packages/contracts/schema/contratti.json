      "$ref": "#/$defs/UploadFirmato"
    },
    "UsoToken": {
      "$ref": "#/$defs/UsoToken"
    },
    "Vestizione": {
      "$ref": "#/$defs/Vestizione"
    },
    "VestizioneColori": {
      "$ref": "#/$defs/VestizioneColori"
    },
