      "$ref": "#/$defs/VoceElencoConversazioni"
    }
  },
  "$defs": {
    "AggiornamentoCapo": {
      "additionalProperties": false,
      "properties": {
        "correzioni": {
          "$ref": "#/$defs/CorrezioniCapo"
        },
        "nome": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "preferito": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "stato": {
          "anyOf": [
            {
              "$ref": "#/$defs/StatoCapo"
            },
            {
              "type": "null"
            }
          ]
        },
        "etichette": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "appunti": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "title": "AggiornamentoCapo",
      "type": "object"
    },
    "AggiornamentoSegnalazione": {
      "additionalProperties": false,
      "properties": {
        "stato": {
          "$ref": "#/$defs/StatoSegnalazione"
        }
      },
      "required": [
        "stato"
      ],
      "title": "AggiornamentoSegnalazione",
      "type": "object"
    },
    "AnalisiAvviata": {
      "additionalProperties": false,
      "description": "L'app riceve un identificativo e interroga lo stato: l'analisi è lenta.\n\nTenerla asincrona è ciò che permette il caricamento in blocco di venti foto\nsenza che l'app resti appesa a una richiesta HTTP di quaranta secondi.",
      "properties": {
        "esecuzione_id": {
          "type": "string"
        },
        "stato": {
          "$ref": "#/$defs/StatoAnalisi"
        }
      },
      "required": [
        "esecuzione_id"
      ],
      "title": "AnalisiAvviata",
      "type": "object"
    },
    "AnalisiVisione": {
      "additionalProperties": false,
      "description": "Traccia di chi ha letto la foto, quando, e con quanta sicurezza.",
      "properties": {
        "provider": {
          "type": "string"
        },
        "modello": {
          "type": "string"
        },
        "eseguita_il": {
          "format": "date-time",
          "type": "string"
        },
        "confidenze": {
          "additionalProperties": {
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/AttributoCapo"
          },
          "type": "object"
        },
        "corretti_a_mano": {
          "items": {
            "$ref": "#/$defs/AttributoCapo"
          },
          "type": "array"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "provider",
        "modello",
        "eseguita_il"
      ],
      "title": "AnalisiVisione",
      "type": "object"
    },
    "AttributoCapo": {
      "description": "Gli attributi che il modello di visione legge dalla foto.\n\nOgnuno porta la sua confidenza: è il motivo per cui `Capo` non ha un unico\npunteggio complessivo.",
      "enum": [
        "tipo",
        "colore",
        "materiale",
        "fantasia",
        "stagione",
        "vestibilita",
        "lavaggio"
      ],
      "title": "AttributoCapo",
      "type": "string"
    },
    "Capo": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "nome": {
          "type": "string"
        },
        "tipo": {
          "$ref": "#/$defs/TipoCapo"
        },
        "slot": {
          "$ref": "#/$defs/SlotAvatar"
        },
        "colore": {
          "$ref": "#/$defs/Colore"
        },
        "foto": {
          "$ref": "#/$defs/FotoCapo"
        },
        "brand": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "sottotipo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "materiale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "fantasia": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "stagione": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stagione"
            },
            {
              "type": "null"
            }
          ]
        },
        "vestibilita": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "lavaggio": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "stato": {
          "$ref": "#/$defs/StatoCapo"
        },
        "preferito": {
          "type": "boolean"
        },
        "ultimo_uso": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "volte_indossato": {
          "type": "integer"
        },
        "analisi": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnalisiVisione"
            },
            {
              "type": "null"
            }
          ]
        },
        "etichette": {
          "description": "Tag liberi dell'utente (es. «lavoro», «da viaggio»): il modello di visione non li scrive mai, per questo restano fuori da `LetturaCapo`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "appunti": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Nota libera dell'utente sul capo. Mai vista dal modello di visione."
        },
        "creato_il": {
          "format": "date-time",
          "type": "string"
        },
        "aggiornato_il": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "id",
        "nome",
        "tipo",
        "slot",
        "colore",
        "foto",
        "creato_il",
        "aggiornato_il"
      ],
      "title": "Capo",
      "type": "object"
    },
    "CapoSintetico": {
      "additionalProperties": false,
      "description": "Il capo come lo vede il modello di suggerimento.\n\nVolutamente magro: meno token per capo significa più capi nel contesto.",
      "properties": {
        "id": {
          "type": "string"
        },
        "nome": {
          "type": "string"
        },
        "tipo": {
          "$ref": "#/$defs/TipoCapo"
        },
        "slot": {
          "$ref": "#/$defs/SlotAvatar"
        },
        "colore": {
          "type": "string"
        },
        "hex": {
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "type": "string"
        },
        "materiale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "stagione": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stagione"
            },
            {
              "type": "null"
            }
          ]
        },
        "stato": {
          "$ref": "#/$defs/StatoCapo"
        },
        "etichette": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "nome",
        "tipo",
        "slot",
        "colore",
        "hex"
      ],
      "title": "CapoSintetico",
      "type": "object"
    },
    "Colore": {
      "additionalProperties": false,
      "description": "Nome leggibile più esadecimale.\n\nL'hex non è un vezzo: è quello che il manichino 3D di oggi usa per tingere le\nmesh, e per ora senza hex l'avatar non sa indossare il capo. È il primo passo:\nl'ADR 0004 porta l'avatar a vestire la foto scontornata del capo come texture,\ne allora il colore diventa il ripiego invece del requisito.",
      "properties": {
        "nome": {
          "type": "string"
        },
        "hex": {
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "type": "string"
        }
      },
      "required": [
        "nome",
        "hex"
      ],
      "title": "Colore",
      "type": "object"
    },
    "ContestoSuggerimento": {
      "additionalProperties": false,
      "description": "Tutto ciò che lo stilista può sapere, e nient'altro.\n\nSe un suggerimento esce strano, è questo il payload da guardare prima di\ndare la colpa al modello.",
      "properties": {
        "capi_disponibili": {
          "items": {
            "$ref": "#/$defs/CapoSintetico"
          },
          "type": "array"
        },
        "meteo": {
          "anyOf": [
            {
              "$ref": "#/$defs/Meteo"
            },
            {
              "type": "null"
            }
          ]
        },
        "agenda": {
          "items": {
            "$ref": "#/$defs/ImpegnoAgenda"
          },
          "type": "array"
        },
        "in_lavaggio": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "indossati_di_recente": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "preferenze": {
          "$ref": "#/$defs/PreferenzeStile"
        },
        "richiesta_utente": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "numero_proposte": {
          "maximum": 5,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "capi_disponibili"
      ],
      "title": "ContestoSuggerimento",
      "type": "object"
    },
    "ConversazioneChat": {
      "additionalProperties": false,
      "description": "Un contenitore di turni: da quando la chat ha smesso di essere una\nsola sessione continua per utente (vedi docs/adr/0006).\n\nRispecchia esattamente le colonne di `conversazioni_chat` — niente qui\ndentro che l'adapter debba inventare per poterla salvare. `turni` e\n`anteprima`, che servono solo all'elenco, vivono in\n`VoceElencoConversazioni`, non qui.",
      "properties": {
        "id": {
          "type": "string"
        },
        "titolo": {
          "type": "string"
        },
        "creata_il": {
          "format": "date-time",
          "type": "string"
        },
        "ultimo_turno_il": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "id",
        "titolo",
        "creata_il",
        "ultimo_turno_il"
      ],
      "title": "ConversazioneChat",
      "type": "object"
    },
    "CorrezioniCapo": {
      "additionalProperties": false,
      "description": "Le correzioni dell'utente, una per attributo, tutte tipizzate.\n\nVolutamente non è `dict[str, str]`: correggere il colore significa mandare\nnome più hex, e il tipo deve stare nell'enum. Un dizionario di stringhe\nfarebbe passare «maglietta» come tipo e lo scopriremmo sull'avatar.",
      "properties": {
        "tipo": {
          "anyOf": [
            {
              "$ref": "#/$defs/TipoCapo"
            },
            {
              "type": "null"
            }
          ]
        },
        "colore": {
          "anyOf": [
            {
              "$ref": "#/$defs/Colore"
            },
            {
              "type": "null"
            }
          ]
        },
        "materiale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "fantasia": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "stagione": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stagione"
            },
            {
              "type": "null"
            }
          ]
        },
        "vestibilita": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "lavaggio": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "title": "CorrezioniCapo",
      "type": "object"
    },
    "Credenziali": {
      "additionalProperties": false,
      "description": "Il corpo di POST /auth/accedi. Nessun requisito sulla password: qui\ndeve solo passare a `bcrypt.checkpw`, non essere accettabile — quello\nvincolo vive in `Registrazione`, non qui, altrimenti un account creato\nquando il minimo era più basso non potrebbe più accedere.",
      "properties": {
        "email": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      },
      "required": [
        "email",
        "password"
      ],
      "title": "Credenziali",
      "type": "object"
    },
    "ElencoCapi": {
      "additionalProperties": false,
      "properties": {
        "capi": {
          "items": {
            "$ref": "#/$defs/Capo"
          },
          "type": "array"
        },
        "totale": {
          "type": "integer"
        }
      },
      "required": [
        "capi",
        "totale"
      ],
      "title": "ElencoCapi",
      "type": "object"
    },
    "ElencoConversazioniChat": {
      "additionalProperties": false,
      "properties": {
        "conversazioni": {
          "items": {
            "$ref": "#/$defs/VoceElencoConversazioni"
          },
          "type": "array"
        }
      },
      "required": [
        "conversazioni"
      ],
      "title": "ElencoConversazioniChat",
      "type": "object"
    },
    "ElencoMessaggiChat": {
      "additionalProperties": false,
      "properties": {
        "messaggi": {
          "items": {
            "$ref": "#/$defs/MessaggioChat"
          },
          "type": "array"
        },
        "conversazione": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConversazioneChat"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "messaggi"
      ],
      "title": "ElencoMessaggiChat",
      "type": "object"
    },
    "ElencoSegnalazioni": {
      "additionalProperties": false,
      "properties": {
        "segnalazioni": {
          "items": {
            "$ref": "#/$defs/Segnalazione"
          },
          "type": "array"
        },
        "amministratore": {
          "type": "boolean"
        }
      },
      "required": [
        "segnalazioni"
      ],
      "title": "ElencoSegnalazioni",
      "type": "object"
    },
    "EsitoAnalisi": {
      "additionalProperties": false,
      "properties": {
        "esecuzione_id": {
          "type": "string"
        },
        "stato": {
          "$ref": "#/$defs/StatoAnalisi"
        },
        "capo": {
          "anyOf": [
            {
              "$ref": "#/$defs/Capo"
            },
            {
              "type": "null"
            }
          ]
        },
        "errore": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "esecuzione_id",
        "stato"
      ],
      "title": "EsitoAnalisi",
      "type": "object"
    },
    "FiltroArmadio": {
      "additionalProperties": false,
      "properties": {
        "tipo": {
          "anyOf": [
            {
              "$ref": "#/$defs/TipoCapo"
            },
            {
              "type": "null"
            }
          ]
        },
        "stato": {
          "anyOf": [
            {
              "$ref": "#/$defs/StatoCapo"
            },
            {
              "type": "null"
            }
          ]
        },
        "solo_preferiti": {
          "type": "boolean"
        },
        "testo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "title": "FiltroArmadio",
      "type": "object"
    },
    "FotoCapo": {
      "additionalProperties": false,
      "properties": {
        "chiave": {
          "description": "Chiave dell'oggetto nell'archivio foto",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "URL firmato, a vita breve"
        },
        "larghezza": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "altezza": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "chiave_scontornata": {
          "anyOf": [
