{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Contratti",
  "description": "Generato da services/api/src/domain/models.py — non modificare a mano.",
  "type": "object",
  "properties": {
    "AnalisiVisione": {
      "$ref": "#/$defs/AnalisiVisione"
    },
    "AttributoCapo": {
      "$ref": "#/$defs/AttributoCapo"
    },
    "Capo": {
      "$ref": "#/$defs/Capo"
    },
    "CapoSintetico": {
      "$ref": "#/$defs/CapoSintetico"
    },
    "Colore": {
      "$ref": "#/$defs/Colore"
    },
    "ContestoSuggerimento": {
      "$ref": "#/$defs/ContestoSuggerimento"
    },
    "ConversazioneChat": {
      "$ref": "#/$defs/ConversazioneChat"
    },
    "Corporatura": {
      "$ref": "#/$defs/Corporatura"
    },
    "EsitoAnalisi": {
      "$ref": "#/$defs/EsitoAnalisi"
    },
    "EsportazionePronta": {
      "$ref": "#/$defs/EsportazionePronta"
    },
    "FotoCapo": {
      "$ref": "#/$defs/FotoCapo"
    },
    "ImpegnoAgenda": {
      "$ref": "#/$defs/ImpegnoAgenda"
    },
    "LetturaCapo": {
      "$ref": "#/$defs/LetturaCapo"
    },
    "MessaggioChat": {
      "$ref": "#/$defs/MessaggioChat"
    },
    "Meteo": {
      "$ref": "#/$defs/Meteo"
    },
    "Misure": {
      "$ref": "#/$defs/Misure"
    },
    "ModelloDisponibile": {
      "$ref": "#/$defs/ModelloDisponibile"
    },
    "OrigineOutfit": {
      "$ref": "#/$defs/OrigineOutfit"
    },
    "Outfit": {
      "$ref": "#/$defs/Outfit"
    },
    "PreferenzeStile": {
      "$ref": "#/$defs/PreferenzeStile"
    },
    "Profilo": {
      "$ref": "#/$defs/Profilo"
    },
    "RichiestaAnalisi": {
      "$ref": "#/$defs/RichiestaAnalisi"
    },
    "RichiestaMessaggioChat": {
      "$ref": "#/$defs/RichiestaMessaggioChat"
    },
    "RichiestaSuggerimenti": {
      "$ref": "#/$defs/RichiestaSuggerimenti"
    },
    "RispostaChat": {
      "$ref": "#/$defs/RispostaChat"
    },
    "RispostaSuggerimenti": {
      "$ref": "#/$defs/RispostaSuggerimenti"
    },
    "RuoloChat": {
      "$ref": "#/$defs/RuoloChat"
    },
    "Segnalazione": {
      "$ref": "#/$defs/Segnalazione"
    },
    "SistemaTaglie": {
      "$ref": "#/$defs/SistemaTaglie"
    },
    "SlotAvatar": {
      "$ref": "#/$defs/SlotAvatar"
    },
    "Stagione": {
      "$ref": "#/$defs/Stagione"
    },
    "StatoAnalisi": {
      "$ref": "#/$defs/StatoAnalisi"
    },
    "StatoCapo": {
      "$ref": "#/$defs/StatoCapo"
    },
    "StatoSegnalazione": {
      "$ref": "#/$defs/StatoSegnalazione"
    },
    "Suggerimento": {
      "$ref": "#/$defs/Suggerimento"
    },
    "Taglia": {
      "$ref": "#/$defs/Taglia"
    },
    "TipoCapo": {
      "$ref": "#/$defs/TipoCapo"
    },
    "UnitaLunghezza": {
      "$ref": "#/$defs/UnitaLunghezza"
    },
    "UsoToken": {
      "$ref": "#/$defs/UsoToken"
    },
    "Vestizione": {
      "$ref": "#/$defs/Vestizione"
    },
    "VestizioneColori": {
      "$ref": "#/$defs/VestizioneColori"
    }
  },
  "$defs": {
    "AnalisiVisione": {
      "additionalProperties": false,
      "description": "Traccia di chi ha letto la foto, quando, e con quanta sicurezza.",
      "properties": {
        "provider": {
          "type": "string"
        },
        "modello": {
          "type": "string"
        },
        "eseguita_il": {
          "format": "date-time",
          "type": "string"
        },
        "confidenze": {
          "additionalProperties": {
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/AttributoCapo"
          },
          "type": "object"
        },
        "corretti_a_mano": {
          "items": {
            "$ref": "#/$defs/AttributoCapo"
          },
          "type": "array"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "provider",
        "modello",
        "eseguita_il"
      ],
      "title": "AnalisiVisione",
      "type": "object"
    },
    "AttributoCapo": {
      "description": "Gli attributi che il modello di visione legge dalla foto.\n\nOgnuno porta la sua confidenza: è il motivo per cui `Capo` non ha un unico\npunteggio complessivo.",
      "enum": [
        "tipo",
        "colore",
        "materiale",
        "fantasia",
        "stagione",
        "vestibilita",
        "lavaggio"
      ],
      "title": "AttributoCapo",
      "type": "string"
    },
    "Capo": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "nome": {
          "type": "string"
        },
        "tipo": {
          "$ref": "#/$defs/TipoCapo"
        },
        "slot": {
          "$ref": "#/$defs/SlotAvatar"
        },
        "colore": {
          "$ref": "#/$defs/Colore"
        },
        "foto": {
          "$ref": "#/$defs/FotoCapo"
        },
        "brand": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "sottotipo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "materiale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "fantasia": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "stagione": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stagione"
            },
            {
              "type": "null"
            }
          ]
        },
        "vestibilita": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "lavaggio": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "stato": {
          "$ref": "#/$defs/StatoCapo"
        },
        "preferito": {
          "type": "boolean"
        },
        "ultimo_uso": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "volte_indossato": {
          "type": "integer"
        },
        "analisi": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnalisiVisione"
            },
            {
              "type": "null"
            }
          ]
        },
        "etichette": {
          "description": "Tag liberi dell'utente (es. «lavoro», «da viaggio»): il modello di visione non li scrive mai, per questo restano fuori da `LetturaCapo`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "appunti": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Nota libera dell'utente sul capo. Mai vista dal modello di visione."
        },
        "creato_il": {
          "format": "date-time",
          "type": "string"
        },
        "aggiornato_il": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "id",
        "nome",
        "tipo",
        "slot",
        "colore",
        "foto",
        "creato_il",
        "aggiornato_il"
      ],
      "title": "Capo",
      "type": "object"
    },
    "CapoSintetico": {
      "additionalProperties": false,
      "description": "Il capo come lo vede il modello di suggerimento.\n\nVolutamente magro: meno token per capo significa più capi nel contesto.",
      "properties": {
        "id": {
          "type": "string"
        },
        "nome": {
          "type": "string"
        },
        "tipo": {
          "$ref": "#/$defs/TipoCapo"
        },
        "slot": {
          "$ref": "#/$defs/SlotAvatar"
        },
        "colore": {
          "type": "string"
        },
        "hex": {
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "type": "string"
        },
        "materiale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "stagione": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stagione"
            },
            {
              "type": "null"
            }
          ]
        },
        "stato": {
          "$ref": "#/$defs/StatoCapo"
        },
        "etichette": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "nome",
        "tipo",
        "slot",
        "colore",
        "hex"
      ],
      "title": "CapoSintetico",
      "type": "object"
    },
    "Colore": {
      "additionalProperties": false,
      "description": "Nome leggibile più esadecimale.\n\nL'hex non è un vezzo: è quello che il manichino 3D di oggi usa per tingere le\nmesh, e per ora senza hex l'avatar non sa indossare il capo. È il primo passo:\nl'ADR 0004 porta l'avatar a vestire la foto scontornata del capo come texture,\ne allora il colore diventa il ripiego invece del requisito.",
      "properties": {
        "nome": {
          "type": "string"
        },
        "hex": {
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "type": "string"
        }
      },
      "required": [
        "nome",
        "hex"
      ],
      "title": "Colore",
      "type": "object"
    },
    "ContestoSuggerimento": {
      "additionalProperties": false,
      "description": "Tutto ciò che lo stilista può sapere, e nient'altro.\n\nSe un suggerimento esce strano, è questo il payload da guardare prima di\ndare la colpa al modello.",
      "properties": {
        "capi_disponibili": {
          "items": {
            "$ref": "#/$defs/CapoSintetico"
          },
          "type": "array"
        },
        "meteo": {
          "anyOf": [
            {
              "$ref": "#/$defs/Meteo"
            },
            {
              "type": "null"
            }
          ]
        },
        "agenda": {
          "items": {
            "$ref": "#/$defs/ImpegnoAgenda"
          },
          "type": "array"
        },
        "in_lavaggio": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "indossati_di_recente": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "preferenze": {
          "$ref": "#/$defs/PreferenzeStile"
        },
        "richiesta_utente": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "numero_proposte": {
          "maximum": 5,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "capi_disponibili"
      ],
      "title": "ContestoSuggerimento",
      "type": "object"
    },
    "ConversazioneChat": {
      "additionalProperties": false,
      "description": "Un contenitore di turni: da quando la chat ha smesso di essere una\nsola sessione continua per utente (vedi docs/adr/0006).\n\nRispecchia esattamente le colonne di `conversazioni_chat` — niente qui\ndentro che l'adapter debba inventare per poterla salvare. `turni` e\n`anteprima`, che servono solo all'elenco, li calcola la vista\n`conversazioni_elenco` del database, che l'app legge da sé.",
      "properties": {
        "id": {
          "type": "string"
        },
        "titolo": {
          "type": "string"
        },
        "creata_il": {
          "format": "date-time",
          "type": "string"
        },
        "ultimo_turno_il": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "id",
        "titolo",
        "creata_il",
        "ultimo_turno_il"
      ],
      "title": "ConversazioneChat",
      "type": "object"
    },
    "Corporatura": {
      "description": "Tre corporature.\n\n**Il deck non dice quali sono**: mostra solo «Media» come valore corrente di\nun selettore di cui non elenca le voci. Queste tre le abbiamo scelte noi, ed\nè registrato in `docs/DOMANDE_APERTE.md` (`D-09`) perché è una lacuna di\nspecifica, non una decisione presa.",
      "enum": [
        "minuta",
        "media",
        "robusta"
      ],
      "title": "Corporatura",
      "type": "string"
    },
    "EsitoAnalisi": {
      "additionalProperties": false,
      "properties": {
        "esecuzione_id": {
          "type": "string"
        },
        "stato": {
          "$ref": "#/$defs/StatoAnalisi"
        },
        "capo": {
          "anyOf": [
            {
              "$ref": "#/$defs/Capo"
            },
            {
              "type": "null"
            }
          ]
        },
        "errore": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "esecuzione_id",
        "stato"
      ],
      "title": "EsitoAnalisi",
      "type": "object"
    },
    "EsportazionePronta": {
      "additionalProperties": false,
      "description": "L'indirizzo da cui l'archivio si scarica, e per quanto ancora vale.\n\n**È l'unica parte che attraversa il confine.** L'app non riceve i dati: ne\nriceve un URL firmato, che apre nel browser di sistema — un'app React\nNative non ha un «scarica», e il browser ce l'ha.\n\n`scade_il` non è decorativo: l'URL è di fatto una credenziale al portatore\nsu tutto l'armadio, quindi l'interfaccia deve poter dire che è a tempo\ninvece di lasciar credere che sia un link da conservare.",
      "properties": {
        "url": {
          "type": "string"
        },
        "scade_il": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "url",
        "scade_il"
      ],
      "title": "EsportazionePronta",
      "type": "object"
    },
    "FotoCapo": {
      "additionalProperties": false,
      "properties": {
        "chiave": {
          "description": "Chiave dell'oggetto nell'archivio foto",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "URL firmato, a vita breve"
        },
        "larghezza": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "altezza": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "chiave_scontornata": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Chiave della stessa foto dopo lo scontorno: soggetto isolato, sfondo trasparente. Assente se lo scontorno non è ancora passato o è fallito — in quel caso l'app mostra l'originale, mai un buco vuoto."
        },
        "url_scontornata": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "URL firmato della foto scontornata"
        }
      },
      "required": [
        "chiave"
      ],
      "title": "FotoCapo",
      "type": "object"
    },
    "ImpegnoAgenda": {
      "additionalProperties": false,
      "properties": {
        "ora": {
          "type": "string"
        },
        "titolo": {
          "type": "string"
        },
        "dress_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ora",
        "titolo"
      ],
      "title": "ImpegnoAgenda",
      "type": "object"
    },
    "LetturaCapo": {
      "additionalProperties": false,
      "description": "Quello che il modello di visione dichiara di aver letto dalla foto.\n\nTutto opzionale per costruzione: «se un attributo non è leggibile metti\nnull, non tirare a indovinare». Non è ancora un `Capo` — diventa tale solo\npassando da `domain.vision.crea_capo`.",
      "properties": {
        "tipo": {
          "anyOf": [
            {
              "$ref": "#/$defs/TipoCapo"
            },
            {
              "type": "null"
            }
          ]
        },
        "sottotipo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "nome_proposto": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "colore": {
          "anyOf": [
            {
              "$ref": "#/$defs/Colore"
            },
            {
              "type": "null"
            }
          ]
        },
        "materiale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "fantasia": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "stagione": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stagione"
            },
            {
              "type": "null"
            }
          ]
        },
        "vestibilita": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "lavaggio": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidenze": {
          "additionalProperties": {
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/AttributoCapo"
          },
          "type": "object"
        }
      },
      "title": "LetturaCapo",
      "type": "object"
    },
    "MessaggioChat": {
      "additionalProperties": false,
      "description": "Un turno di una conversazione con lo stilista.\n\n`testo` sul turno di Wardrobe è la prosa libera della risposta\n(`RispostaStilista.risposta`), quella che si mostra a schermo;\n`suggerimenti`, quando presenti, sono gli outfit proposti nello stesso\nturno. La cronologia rimandata al modello (`domain.chat.cronologia_da_messaggi`)\nriappende gli id di `suggerimenti` al testo, perché il modello non li\nperda al turno successivo.",
      "properties": {
        "id": {
          "type": "string"
        },
        "ruolo": {
          "$ref": "#/$defs/RuoloChat"
        },
        "testo": {
          "type": "string"
        },
        "suggerimenti": {
          "items": {
            "$ref": "#/$defs/Suggerimento"
          },
          "type": "array"
        },
        "creato_il": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "id",
        "ruolo",
        "testo",
        "creato_il"
      ],
      "title": "MessaggioChat",
      "type": "object"
    },
    "Meteo": {
      "additionalProperties": false,
      "properties": {
        "citta": {
          "type": "string"
        },
        "temp_c": {
          "type": "number"
        },
        "condizione": {
          "type": "string"
        },
        "percepita_c": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "citta",
        "temp_c",
        "condizione"
      ],
      "title": "Meteo",
      "type": "object"
    },
    "Misure": {
      "additionalProperties": false,
      "description": "Come si veste un corpo, non com'è fatto.\n\n**Ogni campo è opzionale, e il modello intero può non esserci.** Non è\nlassismo: la schermata del deck offre «Le inserisco dopo» accanto a\n«Continua», e promette «puoi cancellarle quando vuoi». Un `Misure` assente\nè quella promessa mantenuta — non un profilo a metà da riempire.\n\nGli estremi non sono decorativi. Servono a rifiutare un dito che scivola\n(`1680` invece di `168`) prima che finisca in un `jsonb` e da lì\nnell'avatar, dove diventerebbe una persona alta sedici metri.",
      "properties": {
        "sistema_taglie": {
          "anyOf": [
            {
              "$ref": "#/$defs/SistemaTaglie"
            },
            {
              "type": "null"
            }
          ]
        },
        "taglia": {
          "anyOf": [
            {
              "$ref": "#/$defs/Taglia"
            },
            {
              "type": "null"
            }
          ]
        },
        "altezza_cm": {
          "anyOf": [
            {
              "maximum": 230,
              "minimum": 120,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "corporatura": {
          "anyOf": [
            {
              "$ref": "#/$defs/Corporatura"
            },
            {
              "type": "null"
            }
          ]
        },
        "spalle_cm": {
          "anyOf": [
            {
              "maximum": 70,
              "minimum": 30,
