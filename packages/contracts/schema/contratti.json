    },
    "ModelloDisponibile": {
      "$ref": "#/$defs/ModelloDisponibile"
    },
    "NuovaSegnalazione": {
      "$ref": "#/$defs/NuovaSegnalazione"
    },
    "NuovoOutfit": {
      "$ref": "#/$defs/NuovoOutfit"
    },
    "OrigineOutfit": {
      "$ref": "#/$defs/OrigineOutfit"
    },
    "Outfit": {
      "$ref": "#/$defs/Outfit"
    },
    "PreferenzeStile": {
